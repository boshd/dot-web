# Public values are embedded into the browser bundle during `yarn build`.
# Changing one in Railway requires a new deployment.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_DEV_IDENTITY_ENABLED=true

# Server-only runtime URL used by generated-app metadata and manifests.
BENJI_INTERNAL_API_URL=http://localhost:8000
